// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERUSER
  ADMIN
  MANAGER
  FIELD
}

enum UnitType {
  UNIT
  BOX
  CASE
  PALLET
  FOOT
  YARD
  POUND
  OTHER
}

enum AssemblyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  name                String?
  password            String
  role                UserRole           @default(FIELD)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  teamId              String?
  team                Team?              @relation(fields: [teamId], references: [id])
  equipmentLogs       EquipmentLog[]
  assemblies          Assembly[]
  assemblyUsageLogs   AssemblyUsageLog[]
  createdTeams        Team[]             @relation("TeamCreator")
  createdReports      EndOfDayReport[]   @relation("ReportCreator")
  createdFieldReports FieldWorkLog[]     @relation("FieldReportCreator")

  // Job Planning relations
  createdJobPlans    JobPlan[]        @relation("JobPlanCreator")
  jobAssignments     JobAssignment[]  @relation("JobAssignee")
  createdAssignments JobAssignment[]  @relation("AssignmentCreator")
  comments           Comment[]
  notifications      Notification[]
  permitDocuments    PermitDocument[] @relation("DocumentUploader")
  redLightDocuments  RedLightDocument[] @relation("RedLightDocUploader")
}

model Team {
  id           String           @id @default(cuid())
  name         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  creatorId    String
  creator      User             @relation("TeamCreator", fields: [creatorId], references: [id])
  members      User[]
  reports      EndOfDayReport[]
  fieldReports FieldWorkLog[]
}

model Equipment {
  id            String         @id @default(cuid())
  name          String
  sku           String         @unique
  description   String?
  pricePerUnit  Float          @default(0)
  unitType      UnitType       @default(UNIT)
  photoUrl      String?
  boxheroId     Int?           @unique
  lastSyncedAt  DateTime?
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventory     Inventory?
  assemblyItems AssemblyItem[]
  equipmentLogs EquipmentLog[]
}

model Inventory {
  id          String    @id @default(cuid())
  equipmentId String    @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model AssemblyCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  types      AssemblyType[]
  assemblies Assembly[]
}

model AssemblyType {
  id          String           @id @default(cuid())
  name        String
  description String?
  order       Int              @default(0)
  categoryId  String
  category    AssemblyCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assemblies Assembly[]

  @@unique([name, categoryId])
}

model Assembly {
  id          String             @id @default(cuid())
  name        String
  description String?
  status      AssemblyStatus     @default(DRAFT)
  categories  String[]           @default([]) // DEPRECATED: kept for migration
  categoryId  String?
  category    AssemblyCategory?  @relation(fields: [categoryId], references: [id])
  typeId      String?
  type        AssemblyType?      @relation(fields: [typeId], references: [id])
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       AssemblyItem[]
  usageLogs   AssemblyUsageLog[]
  jobPlanAssemblies JobPlanAssembly[]

  @@index([categoryId])
  @@index([typeId])
}

model AssemblyItem {
  id          String    @id @default(cuid())
  assemblyId  String
  assembly    Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  quantity    Int
  createdAt   DateTime  @default(now())
}

model AssemblyUsageLog {
  id         String   @id @default(cuid())
  assemblyId String
  assembly   Assembly @relation(fields: [assemblyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  quantity   Int      @default(1)
  modifiers  Json? // Store extra equipment as JSON
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
}

model EquipmentLog {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  quantity    Int // Positive for add, negative for remove
  type        String // "ADD", "REMOVE", "USED", "RETURNED"
  notes       String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model EndOfDayReport {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User     @relation("ReportCreator", fields: [createdById], references: [id])

  // Manager selects who worked
  workersPresent String[] // Array of user IDs

  // Auto-calculated summaries (stored for historical record)
  totalAssembliesUsed Int
  totalItemsConsumed  Int
  totalFiberFootage   Float?

  // Manager input
  notes  String?
  issues String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Field work logs for this report
  fieldWorkLogs FieldWorkLog[]

  @@unique([date, teamId]) // One report per team per day
}

// System settings (singleton pattern - only one row)
model SystemSettings {
  id          String   @id @default("settings")
  companyName String   @default("CrewKit")
  // Work schedule settings
  workDays    String   @default("[1,2,3,4]") // JSON array of day numbers: 0=Sun, 1=Mon, etc. Default Mon-Thu
  shiftHours  Float    @default(12)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Detailed field work log for construction activities
model FieldWorkLog {
  id String @id @default(cuid())

  // Basic info
  date         DateTime @db.Date
  location     String // Where work was performed
  workersNames String[] // Names of workers (stored as strings for flexibility)
  workerCount  Int      @default(0)
  hoursWorked  Float    @default(0)

  // Team and user tracking
  teamId      String?
  team        Team?   @relation(fields: [teamId], references: [id])
  createdById String?
  createdBy   User?   @relation("FieldReportCreator", fields: [createdById], references: [id])

  // Aerial construction metrics
  strandHungFootage  Float? // Strand hung (feet)
  polesAttached      Int? // Number of poles attached to
  fiberLashedFootage Float? // Fiber lashed (feet)
  fiberPulledFootage Float? // Fiber pulled (feet)

  // Underground construction metrics
  drilledFootage       Float? // Directional drilling (feet)
  plowedFootage        Float? // Plowed conduit (feet)
  trenchedFootage      Float? // Open trench (feet)
  conduitPlacedFootage Float? // Conduit placed (feet)
  conduitSize          String? // Conduit size (e.g., "1.25\"", "2\"")

  // Infrastructure placed
  handholesPlaced Int? // Handholes placed
  vaultsPlaced    Int? // Vaults placed
  mstsInstalled   Int? // MSTs (Mid-Span Terminals) installed
  guysPlaced      Int? // Guy wires/anchors placed
  slackLoops      Int? // Slack loops installed
  risersInstalled Int? // Risers installed
  spliceCases     Int? // Splice cases installed
  anchorsPlaced   Int? // Anchors placed
  snowshoesPlaced Int? // Snowshoes placed

  // Notes and issues
  notes       String?
  issues      String? // Issues/blockers encountered
  submittedBy String // Name of person who submitted

  // Optional link to EOD report (deprecated, kept for migration)
  reportId String?
  report   EndOfDayReport? @relation(fields: [reportId], references: [id])

  // Original timestamp from import
  originalTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([location])
  @@index([teamId])
  @@index([createdById])
}

// ============================================================
// JOB PLANNING SYSTEM
// ============================================================

// Project Areas for standardized job naming
model ProjectArea {
  id          String    @id @default(cuid())
  name        String    @unique  // "West Mountain"
  prefix      String    @unique  // "WM"
  nextSeq     Int       @default(1)  // Next sequence number for this area
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  jobPlans    JobPlan[]
}

enum JobPlanStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model JobPlan {
  id String @id @default(cuid())

  // ========== PLANNING PHASE ==========

  // Step 1: Permits (Legacy - kept for backwards compatibility)
  rmpPermitApproved  Boolean @default(false)
  sesdPermitApproved Boolean @default(false)
  makeReadyComplete  Boolean @default(false)
  easementsClear     Boolean @default(false)

  // ========== RED LIGHT CHECK (Safety Gate) ==========
  
  // Zone A: Legal & Permitting
  redLightDotPermit       Boolean  @default(false)
  redLightRowConfirmed    Boolean  @default(false)
  dotPermitNumber         String?
  rowConfirmationNotes    String?

  // Zone B: Safety (Life Savers)
  redLightPowerLines      Boolean  @default(false)
  redLightTrafficControl  Boolean  @default(false)
  powerLineNotes          String?

  // Zone C: Design
  redLightPrintVerified   Boolean  @default(false)
  printVerificationNotes  String?

  // Master gate status (computed but cached for queries)
  redLightCleared         Boolean   @default(false)
  redLightClearedAt       DateTime?
  redLightClearedById     String?

  // Step 2: Route Details
  jobName         String   // Auto-generated: {prefix}-{MMYY}-{seq}
  jobNumber       String?  // Internal job/project number (legacy, optional)
  
  // Project Area for standardized naming
  projectAreaId   String?
  projectArea     ProjectArea? @relation(fields: [projectAreaId], references: [id])
  sequenceNumber  Int?     // Job's sequence within its project area
  locationName    String?  // Area name (e.g., "Oak Hills Phase 2")
  locationAddress String?  // Full address for navigation
  locationLat     Float?   // Latitude for map thumbnail
  locationLng     Float?   // Longitude for map thumbnail
  vetroProjectUrl String?  // Link to Vetro FiberMap project
  
  // Build Spec
  jobBuildType       String   @default("full_build")  // "full_build" | "strand_build" | "fiber_build" | "peripheral_build"
  primaryMethod      String?  // DEPRECATED: "aerial" | "underground" | "both" (kept for backward compatibility)
  constructionType   String?  // DEPRECATED: "new_strand" | "overlash" | "adss" | "ug_dip" (kept for backward compatibility)
  cableProfile       String?  // e.g., "144ct Loose Tube"
  sagTensionSpec     String?  // e.g., "NESC Heavy"
  
  // Scope Breakdown
  totalDistance      Float    // Legacy: Total footage (computed from breakdown)
  aerialFootage      Float    @default(0)  // Aerial construction footage
  undergroundFootage Float    @default(0)  // Underground/riser footage
  slackLoopFootage   Float    @default(0)  // Slack loop footage
  poleCount          Int      @default(0)  // Number of poles in job
  makeReadyRequired  Boolean  @default(false) // Requires make-ready work first
  
  // Access & Logistics
  gateCode           String?  // Gate codes, lockbox info
  poleOwner          String?  // e.g., "Rocky Mountain Power"
  trafficControlTier String?  // "none" | "cones" | "flaggers"
  siteContactName    String?  // On-site contact name
  siteContactPhone   String?  // On-site contact phone

  // Step 3: Materials (Planned)
  strandFootage Float
  fiberFootage  Float
  deadEnds      Int   @default(0)
  tangents      Int   @default(0)
  anchors       Int   @default(0)

  // Step 4: Hazards
  trafficControl    Boolean @default(false)
  treeTrimming      Boolean @default(false)
  animalHazards     Boolean @default(false)
  waterRailCrossing Boolean @default(false)
  foremanNotes      String?

  // Step 5: Crew Assignment (handled via JobAssignment relation)

  // Step 6: Scheduling
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  estimatedDuration Float? // in hours or days
  durationUnit      String? // "hours" or "days"
  overtimeApproved  Boolean  @default(false) // Legacy - kept for backward compatibility
  customWorkDays    String?  // JSON array of day numbers for per-job override (null = use global)

  // ========== CONSTRUCTION PHASE (Cumulative Totals) ==========

  // Actual progress totals (updated from daily logs)
  actualFootage       Float @default(0)
  actualPolesComplete Int   @default(0)

  // Actual materials used (updated from daily logs)
  actualStrandUsed Float @default(0)
  actualFiberUsed  Float @default(0)
  actualDeadEnds   Int   @default(0)
  actualTangents   Int   @default(0)
  actualAnchors    Int   @default(0)

  // Crew hours total
  totalCrewHours Float @default(0)

  // ========== REPORTING PHASE ==========

  // Sign-off
  foremanSignoff Boolean   @default(false)
  signoffDate    DateTime?
  signoffById    String?

  // Lessons learned
  lessonsLearned String?

  // Completion
  completedAt DateTime?

  // ========== STATUS & METADATA ==========

  status   JobPlanStatus @default(DRAFT)
  priority JobPriority   @default(MEDIUM)

  // Relationships
  createdById String
  createdBy   User            @relation("JobPlanCreator", fields: [createdById], references: [id])
  assignments JobAssignment[]
  comments    Comment[]

  // Construction logs
  progressLogs  DailyProgressLog[]
  materialLogs  MaterialUsageLog[]
  crewHoursLogs CrewHoursLog[]
  issueLogs     IssueLog[]

  // Dynamic permits system
  permits JobPermit[]
  
  // Construction prints (PDFs)
  constructionPrints ConstructionPrint[]
  
  // Bill of Materials (imported from GIS/Shapefiles)
  bom JobBOM?
  
  // Required assemblies (from map detection or manual entry)
  requiredAssemblies JobPlanAssembly[]
  
  // Red Light Check documents
  redLightDocuments RedLightDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

// ============================================================
// JOB PLAN ASSEMBLIES (Required assemblies per job)
// ============================================================

model JobPlanAssembly {
  id           String   @id @default(cuid())
  jobPlanId    String
  jobPlan      JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  assemblyId   String?  // Optional - may not have matching Assembly record
  assembly     Assembly? @relation(fields: [assemblyId], references: [id])
  quantity     Int      @default(1)
  
  // Source tracking
  assemblyType   String   // "Terminal Pole", "Tangent Pole", etc. - unique per job
  isAutoDetected Boolean  @default(true)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jobPlanId, assemblyType]) // Changed: unique per type, not per assembly
  @@index([jobPlanId])
}

// ============================================================
// CONSTRUCTION DAILY LOGS
// ============================================================

model DailyProgressLog {
  id          String   @id @default(cuid())
  jobPlanId   String
  jobPlan     JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  footage     Float
  poles       Int      @default(0)
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobPlanId])
  @@index([date])
}

model MaterialUsageLog {
  id          String   @id @default(cuid())
  jobPlanId   String
  jobPlan     JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  strand      Float?
  fiber       Float?
  deadEnds    Int?
  tangents    Int?
  anchors     Int?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobPlanId])
  @@index([date])
}

model CrewHoursLog {
  id          String   @id @default(cuid())
  jobPlanId   String
  jobPlan     JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  userId      String
  userName    String? // Store name for display even if user deleted
  hours       Float
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobPlanId])
  @@index([date])
  @@index([userId])
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
}

model IssueLog {
  id          String        @id @default(cuid())
  jobPlanId   String
  jobPlan     JobPlan       @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  description String
  severity    IssueSeverity @default(MEDIUM)
  resolved    Boolean       @default(false)
  resolvedAt  DateTime?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([jobPlanId])
  @@index([date])
  @@index([resolved])
}

model JobAssignment {
  id           String   @id @default(cuid())
  jobPlanId    String
  jobPlan      JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("JobAssignee", fields: [userId], references: [id])
  assignedById String
  assignedBy   User     @relation("AssignmentCreator", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([jobPlanId, userId])
  @@index([userId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  jobPlanId String
  jobPlan   JobPlan   @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  mentions  String[] // Array of user IDs mentioned
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([jobPlanId])
  @@index([parentId])
}

enum NotificationType {
  JOB_ASSIGNED
  COMMENT_MENTION
  COMMENT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  jobPlanId String?
  title     String
  message   String // Truncated preview
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================================
// DYNAMIC PERMITS SYSTEM
// ============================================================

model PermitType {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isDefault   Boolean     @default(false) // System defaults can't be deleted
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  permits     JobPermit[]
}

model JobPermit {
  id           String           @id @default(cuid())
  jobPlanId    String
  jobPlan      JobPlan          @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  permitTypeId String
  permitType   PermitType       @relation(fields: [permitTypeId], references: [id])
  isApproved   Boolean          @default(false)
  notes        String?
  documents    PermitDocument[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([jobPlanId, permitTypeId])
  @@index([jobPlanId])
}

model PermitDocument {
  id           String    @id @default(cuid())
  jobPermitId  String
  jobPermit    JobPermit @relation(fields: [jobPermitId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String // "application/pdf", "image/jpeg", etc.
  fileSize     Int // bytes
  uploadedById String
  uploadedBy   User      @relation("DocumentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  @@index([jobPermitId])
}

// ============================================================
// CONSTRUCTION PRINTS (Route Details PDFs)
// ============================================================

model ConstructionPrint {
  id           String   @id @default(cuid())
  jobPlanId    String
  jobPlan      JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileType     String   // "application/pdf", "image/jpeg", etc.
  fileSize     Int      // bytes
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([jobPlanId])
}

// ============================================================
// BILL OF MATERIALS (BOM) - Imported from GIS/Shapefiles
// ============================================================

model JobBOM {
  id          String   @id @default(cuid())
  jobPlanId   String   @unique
  jobPlan     JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  
  // Import metadata
  importedAt    DateTime?
  sourceFiles   String[]  // Original shapefile names
  
  // Selection state (what's included in job scope)
  selectionBoundary  Json?      // GeoJSON polygon of user-drawn selection
  selectedPhases     String[]   // Array of selected SubPhase values
  
  // Parsed line items
  fiberSegments    JobFiberSegment[]
  infrastructure   JobInfrastructure[]
  conduitSegments  JobConduitSegment[]
  
  // User-defined segments for grouping source files
  segments         JobSegment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Fiber cable segments (Backbone, Lateral, Drops)
model JobFiberSegment {
  id      String  @id @default(cuid())
  bomId   String
  bom     JobBOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  
  segmentType   String    // "backbone", "lateral", "drop", "mst_tail"
  fiberCount    Int       // 288, 144, 96, 48, 24, 12, etc.
  footage       Float
  cableType     String?   // "loose_tube", "ribbon", "flat_drop"
  description   String?   // Additional notes from GIS
  
  // Source file tracking for layer management
  sourceFileId  String?   // Name of source shapefile (e.g., "backbone")
  
  // GeoJSON geometry for map display (optional)
  geometry      Json?
  
  // Selection tracking
  isSelected    Boolean   @default(false)  // Included in job scope?
  
  createdAt DateTime @default(now())
  
  @@index([bomId])
  @@index([segmentType])
  @@index([sourceFileId])
  @@index([isSelected])
}

// Infrastructure points (MSTs, Vaults, Handholes, Splices, etc.)
model JobInfrastructure {
  id      String  @id @default(cuid())
  bomId   String
  bom     JobBOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  
  itemType    String    // "mst", "vault", "handhole", "pedestal", "splice", "riser", "slack_loop", "guy", "anchor", "pole", "crossing"
  quantity    Int       @default(1)
  specs       String?   // Size, model, capacity (e.g., "36x48 vault", "8-port MST")
  label       String?   // ID/label from GIS (e.g., "VLT305", "MST-12")
  subPhase    String?   // SubPhase from poles data (e.g., "3.1", "3.2")
  poleType    String?   // Pole type from shapefile (Terminal, Tangent, Corner, Junction, etc.)
  tailFootage Float?    // MST tail cable length in feet
  
  // Source file tracking for layer management
  sourceFileId  String?   // Name of source shapefile (e.g., "poles")
  
  // GeoJSON point for map display (optional)
  location    Json?
  
  // Selection & Progress tracking
  isSelected    Boolean   @default(true)   // Included in job scope?
  isCompleted   Boolean   @default(false)  // Construction complete?
  completedAt   DateTime?
  completedById String?
  
  createdAt DateTime @default(now())
  
  @@index([bomId])
  @@index([itemType])
  @@index([subPhase])
  @@index([sourceFileId])
  @@index([isCompleted])
}

// Conduit segments with size specifications
model JobConduitSegment {
  id      String  @id @default(cuid())
  bomId   String
  bom     JobBOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  
  conduitSize   String    // "1.25", "2", "4" (inches)
  footage       Float
  conduitType   String?   // "HDPE", "PVC", "innerduct"
  description   String?
  
  // Source file tracking for layer management
  sourceFileId  String?   // Name of source shapefile (e.g., "conduit")
  
  // GeoJSON geometry for map display (optional)
  geometry      Json?
  
  // Selection tracking
  isSelected    Boolean   @default(false)  // Included in job scope?
  
  createdAt DateTime @default(now())
  
  @@index([bomId])
  @@index([sourceFileId])
  @@index([isSelected])
}

// User-defined segments for grouping source files
model JobSegment {
  id          String   @id @default(cuid())
  bomId       String
  bom         JobBOM   @relation(fields: [bomId], references: [id], onDelete: Cascade)
  
  name        String   // User-defined segment name (e.g., "Phase 1", "Main Route")
  fileIds     String[] // Array of sourceFileId values in this segment
  color       String?  // Optional display color for the segment
  order       Int      @default(0) // Display order
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([bomId])
}

// ============================================================
// RED LIGHT CHECK DOCUMENTS
// ============================================================

model RedLightDocument {
  id           String   @id @default(cuid())
  jobPlanId    String
  jobPlan      JobPlan  @relation(fields: [jobPlanId], references: [id], onDelete: Cascade)
  checkType    String   // "dot_permit" | "row_confirmed" | "power_lines" | "traffic_control"
  fileName     String
  fileUrl      String
  fileType     String   // "application/pdf", "image/jpeg", etc.
  fileSize     Int      // bytes
  uploadedById String
  uploadedBy   User     @relation("RedLightDocUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([jobPlanId, checkType])
}
